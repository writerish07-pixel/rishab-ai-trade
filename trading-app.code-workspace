{
  "folders": [
    { "name": "Root", "path": "." },
    { "name": "Backend (FastAPI)", "path": "backend" },
    { "name": "Frontend (Next.js)", "path": "frontend" },
    { "name": "Database", "path": "database" }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "python.defaultInterpreterPath": "./backend/venv/bin/python",
    "python.analysis.typeCheckingMode": "basic",
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter",
      "editor.tabSize": 4
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/node_modules": true,
      "**/.next": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.black-formatter",
      "charliermarsh.ruff",
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "ms-vscode.vscode-typescript-next",
      "ckolkman.vscode-postgres",
      "ms-azuretools.vscode-docker"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Start Backend",
        "type": "shell",
        "command": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
        "group": "build",
        "presentation": { "panel": "new", "name": "Backend" }
      },
      {
        "label": "Start Frontend",
        "type": "shell",
        "command": "cd frontend && npm run dev",
        "group": "build",
        "presentation": { "panel": "new", "name": "Frontend" }
      },
      {
        "label": "Start Docker Services",
        "type": "shell",
        "command": "docker-compose up -d postgres redis",
        "group": "build",
        "presentation": { "panel": "new", "name": "Docker" }
      },
      {
        "label": "Start All (Docker)",
        "type": "shell",
        "command": "docker-compose up --build",
        "group": "build",
        "presentation": { "panel": "new", "name": "Docker Full" }
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug Backend",
        "type": "python",
        "request": "launch",
        "module": "uvicorn",
        "args": ["app.main:app", "--reload", "--port", "8000"],
        "cwd": "${workspaceFolder}/backend",
        "env": { "PYTHONPATH": "${workspaceFolder}/backend" }
      }
    ]
  }
}
