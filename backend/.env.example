# ============================================
# AI Trading App - Backend Environment Config
# Copy this to .env and fill in your values
# ============================================

# App
APP_NAME=AI Trading App
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://trader:trader123@localhost:5432/trading_db
DATABASE_SYNC_URL=postgresql://trader:trader123@localhost:5432/trading_db

# Redis
REDIS_URL=redis://localhost:6379/0

# ============================================
# Angel One SmartAPI Credentials
# Get from: https://smartapi.angelbroking.com/
# ============================================
ANGEL_ONE_API_KEY=your_angel_one_api_key
ANGEL_ONE_CLIENT_ID=your_client_id
ANGEL_ONE_PASSWORD=your_trading_password
ANGEL_ONE_TOTP_SECRET=your_totp_base32_secret

# ============================================
# Alpaca (US Market / Paper Trading)
# Get from: https://app.alpaca.markets/
# ============================================
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ============================================
# Polygon.io
# Get from: https://polygon.io/
# ============================================
POLYGON_API_KEY=your_polygon_api_key

# Market data source preference
MARKET_DATA_PRIMARY=angel_one
MARKET_DATA_FALLBACK=yfinance

# AI Engine
SIGNAL_CONFIDENCE_THRESHOLD=0.65
MAX_SIGNALS_PER_DAY=20

# CORS (adjust to your frontend URL)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
